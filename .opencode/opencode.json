{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "oh-my-opencode-slim@2.2.25"
  ],
  "default_agent": "plan",
  "share": "disabled",
  "instructions": ["AGENTS.md"],
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge*", "effect": "ask" },
    { "action": "shell", "resource": "gh repo delete*", "effect": "deny" },
    { "action": "github_*", "resource": "*", "effect": "deny" },
    { "action": "github_get_*", "resource": "*", "effect": "allow" },
    { "action": "github_list_*", "resource": "*", "effect": "allow" },
    { "action": "github_search_*", "resource": "*", "effect": "allow" }
  ],
  "agents": {
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "plan": {
      "model": "opencode/mimo-v2.6-flash-free#high"
    },
    "build": {
      "model": "opencode/mimo-v2.6-flash-free"
    },
    "title": {
      "model": "opencode/space-bunny-free"
    }
  },
  "mcp": {
    "servers": {
      "engram": {
        "type": "local",
        "command": ["engram", "mcp", "--tools=agent"]
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest", "--caps=core,network,vision"]
      },
      "github": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
        "disabled": true,
        "environment": {
          "GITHUB_TOKEN": "{env:GH_TOKEN}"
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "providers": {
    "copilot": {},
    "openai": {},
    "opencode-go": {},
    "opencode": {}
  }
}
